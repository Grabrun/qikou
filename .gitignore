# ---------------------------------------------------------------
# 气口 / Cadence (qikou) —— 忽略规则
# 原则：只跟踪源码、文档、语料；不跟踪任何生成物。
# ---------------------------------------------------------------

# Python 字节码与缓存
__pycache__/
*.py[cod]
*$py.class

# 自动测试报告（由 python -m qikou --test 生成，每次带时间戳）
tests/results/

# 颜文字来源数据：4 个上游导出文件（gboard / googlejp / msime / ios.plist，
# 约 13.7 MB），未被任何代码引用，仅本地保留、不入库。
# 实际加载的语料已移入包内：qikou/data/kaomojis.txt（随 wheel 分发）。
Kaomoji/

# 个人使用、与项目无关的辅助文件：提示词及其本地版本库。
# 两者都不进 GitHub —— .prompt/ 自带一个独立仓库，Prompt.txt 在其中。
.prompt/
Prompt.txt

# 交接文档：只作本地参考，不进 GitHub。
HANDOVER.md

# 打包 / 构建产物
build/
dist/
*.egg-info/
.eggs/

# 虚拟环境（.venv、.venv-build、.venv-test 等）
.venv*/
venv/
env/

# 编辑器 / 操作系统
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
