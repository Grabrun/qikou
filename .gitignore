# ---------------------------------------------------------------
# 气口 / Cadence (qikou) —— 忽略规则
# 原则：只跟踪源码、文档、语料；不跟踪任何生成物。
# ---------------------------------------------------------------

# Python 字节码与缓存
__pycache__/
*.py[cod]
*$py.class

# 自动测试报告（由 qikou test 生成，每次带时间戳）
tests/results/

# 本机私有目录：上游颜文字导出存档、历史测试报告、交接文档快照、个人提示词。
# 放这里的都是「有用但不属于仓库内容」的东西，说明见 local/README.md。
# 其中字面加载的语料在包内：qikou/kaomojis.txt（随 wheel 分发）。
local/

# 交接文档：只作本地参考，不进 GitHub（通常放在 local/handover/）
HANDOVER.md

# 打包 / 构建产物
build/
dist/
*.egg-info/
.eggs/

# 历史版本归档（每个版本一个目录，见 local/README.md 的版本约定）
releases/

# 虚拟环境（.venv、.venv-build、.venv-test 等）
.venv*/
venv/
env/

# 编辑器 / 操作系统
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
